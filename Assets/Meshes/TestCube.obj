# TestCube.obj

mtllib TestCube.mtl

usemtl TestTexture

v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5

vt 0.0 1.0
vt 1.0 1.0
vt 1.0 0.0
vt 0.0 0.0

vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn -1.0  0.0  0.0
vn  1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# Front (+Z)
f 5/1/1 6/2/1 7/3/1
f 5/1/1 7/3/1 8/4/1

# Back (-Z)
f 2/1/2 1/2/2 4/3/2
f 2/1/2 4/3/2 3/4/2

# Left (-X)
f 1/1/3 5/2/3 8/3/3
f 1/1/3 8/3/3 4/4/3

# Right (+X)
f 6/1/4 2/2/4 3/3/4
f 6/1/4 3/3/4 7/4/4

# Top (+Y)
f 4/1/5 8/2/5 7/3/5
f 4/1/5 7/3/5 3/4/5

# Bottom (-Y)
f 1/1/6 2/2/6 6/3/6
f 1/1/6 6/3/6 5/4/6

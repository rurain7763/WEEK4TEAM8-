# Hexagonal prism test mesh.
# This file deliberately includes 6-sided polygon faces (the top and bottom)
# as well as quad side faces, so OBJ importers can exercise ngon support.
mtllib TestHexagonalPrism.mtl

usemtl ExplosionAtlas

# Bottom ring (z = -0.5)
v  0.500000  0.000000 -0.500000
v  0.250000  0.433013 -0.500000
v -0.250000  0.433013 -0.500000
v -0.500000  0.000000 -0.500000
v -0.250000 -0.433013 -0.500000
v  0.250000 -0.433013 -0.500000

# Top ring (z = 0.5)
v  0.500000  0.000000  0.500000
v  0.250000  0.433013  0.500000
v -0.250000  0.433013  0.500000
v -0.500000  0.000000  0.500000
v -0.250000 -0.433013  0.500000
v  0.250000 -0.433013  0.500000

vn  0.000000  0.000000 -1.000000
vn  0.000000  0.000000  1.000000
vn  0.866025  0.500000  0.000000
vn  0.000000  1.000000  0.000000
vn -0.866025  0.500000  0.000000
vn -0.866025 -0.500000  0.000000
vn  0.000000 -1.000000  0.000000
vn  0.866025 -0.500000  0.000000

# Texture coordinates: one UV per vertex on each cap.
vt 1.000000 0.500000
vt 0.750000 0.933013
vt 0.250000 0.933013
vt 0.000000 0.500000
vt 0.250000 0.066987
vt 0.750000 0.066987
vt 1.000000 0.500000
vt 0.750000 0.933013
vt 0.250000 0.933013
vt 0.000000 0.500000
vt 0.250000 0.066987
vt 0.750000 0.066987

# Six-sided polygon faces (ngons)
f 1/1/1 6/6/1 5/5/1 4/4/1 3/3/1 2/2/1
f 7/7/2 8/8/2 9/9/2 10/10/2 11/11/2 12/12/2

# Quad side faces
f 1/1/3 2/2/3 8/8/3 7/7/3
f 2/2/4 3/3/4 9/9/4 8/8/4
f 3/3/5 4/4/5 10/10/5 9/9/5
f 4/4/6 5/5/6 11/11/6 10/10/6
f 5/5/7 6/6/7 12/12/7 11/11/7
f 6/6/8 1/1/8 7/7/8 12/12/8
